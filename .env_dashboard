# ============================================================
#  DASHBOARD MODULE CONFIG  (loaded ONLY by the new dashboard
#  sync engine — completely separate from the app's .env)
# ============================================================

# ------------------------------------------------------------
# 1) MANUAL WORKSPACE TOKENS (Option B — paste xoxp here)
# ------------------------------------------------------------
# These are optional. Workspaces you connected with OAuth inside
# the app are already available automatically launch, so the
# only tokens you would need here are for the workspaces
# where you did not perform the OAuth flow.
#
# Format — one line per token. Treated as Secrets: Keep this file secret and never commit it.
#
# Examples:
#   DASH_TOKEN_CLIENT_A=xoxp-1234-abcd-...
#   DASH_TOKEN_CLIENT_B=xoxp-5678-fghi-...
DASH_TOKEN_CLIENT_A=
DASH_TOKEN_CLIENT_B=
DASH_TOKEN_CLIENT_C=

# ------------------------------------------------------------
# 2) SCOPES the engine asks for/offered at connect time
# ------------------------------------------------------------
# These are the required READ scopes, for every token in this file
# for every workspace the engine monitors:
#
#   channels:read, channels:history      public channels: list + messages
#   groups:read,   groups:history        private channels/groups: list + messages
#   team:read                            workspace info (name / logo)
#   users:read,    users.profile:read    who wrote what (mood + card health)
#   im:read,       im:history            project DMs
#   mpim:read,     mpim:history          group DMs
#   emoji:read                           reactions used by the mood heuristic (optional)
#
# Only comment this if you are 'pasting' a token created elsewhere:
# the token MUST have ALL scopes above enabled in its Slack app.
DASH_REQUIRED_SCOPES=channels:read,channels:history,groups:read,groups:history,team:read,users:read,users.profile:read,im:read,im:history,mpim:read,mpim:history,emoji:read

# ------------------------------------------------------------
# 3) ENGINE SETTINGS (with sensible defaults)
# ------------------------------------------------------------
# Sync poll interval (5 min = 300s). CHANGE ONLY IF NEEDED
DASH_SYNC_INTERVAL_SECONDS=300

# -- first sync topN messages per channel (default 200)
DASH_FIRST_SYNC_TOPN=200

# -- data folder overrides (pretty safe: also can leave empty)
# '/storage'
# DASH_DATA_DIR=~/.slack-dashboard/dashboard
